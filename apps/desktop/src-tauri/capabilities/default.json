{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window only: core defaults plus every app command (declared in build.rs). The overlay window gets none of these.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-last-status",
    "allow-history-list",
    "allow-history-copy",
    "allow-history-reoutput",
    "allow-history-delete",
    "allow-history-clear",
    "allow-cloud-kinds",
    "allow-cloud-list",
    "allow-cloud-models",
    "allow-cloud-test-connection",
    "allow-cloud-save",
    "allow-cloud-remove",
    "allow-cloud-open-key-page",
    "allow-presets-list",
    "allow-presets-preview",
    "allow-presets-apply",
    "allow-config-pick-open",
    "allow-config-pick-save",
    "allow-config-export",
    "allow-config-import-preview",
    "allow-config-import-apply",
    "allow-vocab-get",
    "allow-vocab-set",
    "allow-settings-get",
    "allow-settings-apply",
    "allow-settings-set-autostart",
    "allow-settings-input-devices",
    "allow-settings-preview",
    "allow-settings-runtime-status",
    "allow-settings-test-local-asr",
    "allow-gpu-usage",
    "allow-models-status",
    "allow-models-download",
    "allow-models-cancel",
    "allow-models-import-breeze",
    "allow-onboarding-status",
    "allow-onboarding-restart",
    "allow-open-doc",
    "allow-mic-test-start",
    "allow-mic-test-stop"
  ]
}
