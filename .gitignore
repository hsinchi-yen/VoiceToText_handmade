# Build output
target/
# Built installers and their checksums (tools/build-installer.ps1) — never commit.
# Exception: releases/linux/build.sh and README.md are tracked; the Linux .deb / AppImage /
# SHA256SUMS.txt that build.sh writes next to them are not.
releases/*
!releases/linux/
releases/linux/*
!releases/linux/build.sh
!releases/linux/README.md
node_modules/
dist/
apps/android/.gradle/
apps/android/build/
apps/android/app/build/
apps/android/local.properties

# Test audio is the user's own voice — never commit it
tests/fixtures/audio/*.wav
tests/fixtures/audio/*.m4a

# Throwaway test artifacts (models, generated audio, bench output)
tests/tmp/

# Model files
*.gguf
*.bin
*.onnx
models/

# Local config / secrets
*.local.toml
.env

# Claude Code local state
.claude/*.local.*
.claude/worktrees/
